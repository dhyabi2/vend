# Vend-owned environment. Loaded AFTER /root/.hermes/.env so it wins.
# The reachable host for the API while paypercall.dev (Vercel) is switched off
# by the owner. Every manifest and 402 advertises exactly this host, so a
# buyer's agent always gets a URL that actually answers.
VEND_HOST=127.0.0.1
VEND_PORT=8402
VEND_DOMAIN=extract.paypercall.dev
VEND_PRICE_EXTRACT=0.0001
# Base URL with the actual scheme the server speaks. Without this, server.py
# defaults to https://{DOMAIN} which sends agents to a dead TLS handshake.
VEND_BASE_URL=https://extract.paypercall.dev
# agent-tools.cloud host-ownership proof: the token is served verbatim at
# /.well-known/agent-tools-verify.txt. It is a directory token, not a secret
# key; kept in state/ (gitignored) rather than committed.
VEND_VERIFY_TOKEN_FILE=/root/vend/state/agent-tools-verify.txt
VEND_VERIFY_TOKEN_DIR=/root/vend/state/verify-tokens
